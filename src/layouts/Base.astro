---
import '../styles/global.css';
import { LOCALE_META, type Locale } from '../i18n';

interface Props {
  theme: string;
  title: string;
  description: string;
  locale?: Locale;
  noindex?: boolean;
}
const { theme, title, description, locale = 'en', noindex = false } = Astro.props;
const meta = LOCALE_META[locale];
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={meta.htmlLang} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/png" href={`${base}gufo-logo.png`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0614" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
