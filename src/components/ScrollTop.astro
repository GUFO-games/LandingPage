---
import { useTranslations, type Locale } from '../i18n';
import gufoLogo from '../assets/GUFO.png';
import { Image } from 'astro:assets';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<button type="button" class="scroll-top" data-scroll-top aria-label={t('top.backToTop')}>
  <Image src={gufoLogo} alt="" aria-hidden="true" width={32} height={32} densities={[1, 2]} />
  <span class="scroll-streak" aria-hidden="true"></span>
</button>
