---
import { LOCALES, LOCALE_META, localeUrl, useTranslations, type Locale } from '../i18n';
import Flag from './Flag.astro';

interface Props { locale: Locale; page?: 'landing' | 'feedback' }
const { locale, page = 'landing' } = Astro.props;
const t = useTranslations(locale);
const current = LOCALE_META[locale];
---
<div class="lang" data-lang>
  <button
    type="button"
    class="lang-btn"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t('lang.label')}
  >
    <Flag code={current.flag} />
    <span>{locale.toUpperCase()}</span>
    <svg class="lang-caret" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none"
      ><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg
    >
  </button>

  <ul class="lang-menu" role="listbox" aria-label={t('lang.select')} hidden>
    {LOCALES.map((code) => (
      <li
        class="lang-option"
        role="option"
        tabindex="0"
        aria-selected={code === locale ? 'true' : 'false'}
        data-locale={code}
        data-href={localeUrl(code, page)}
      >
        <Flag code={LOCALE_META[code].flag} />
        <span class="lang-name" lang={LOCALE_META[code].htmlLang}>{LOCALE_META[code].native}</span>
        <svg class="lang-check" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none"
          ><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg
        >
      </li>
    ))}
  </ul>
</div>
