---
import FeedbackPage from '../../../components/FeedbackPage.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---
<FeedbackPage locale={locale} />
