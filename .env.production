# production. Committed on purpose: public URLs and feature flags only.
# Loaded by `astro build` (Astro's default mode is "production").
PUBLIC_SITE_URL=https://gufo-games.labyrainth.com

# TEMPORARILY OFF - turn back on in WP12, when Plausible actually exists at
# stats.labyrainth.com. Left on, every visitor's browser requests a script from
# a host that does not resolve: a DNS lookup, a failed connection and a console
# error on every page load. Do not reference a service that is not there yet.
PUBLIC_ANALYTICS=off

MINIFY=true
